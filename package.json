{
  "name": "geoform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": ".venv/bin/python -m server.api --host 127.0.0.1 --port 8765",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:client && npm run test:api",
    "test:client": "vitest run",
    "test:api": ".venv/bin/python -m pytest tests -q",
    "start": ".venv/bin/python -m server.api --host 127.0.0.1 --port 8765",
    "start:prod": ".venv/bin/python -m server.api --host 0.0.0.0 --port 8765",
    "install:all": "bash scripts/install.sh",
    "docker:build": "docker build -t geoform .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "happy-dom": "^20.11.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^2.1.9"
  }
}
