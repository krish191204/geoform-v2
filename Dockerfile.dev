# Single-stage dev image: installs both Python venv and node_modules,
# then runs `npm run dev`. Useful for docker-based dev.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      python3.12-dev \
      nodejs \
      npm \
      ca-certificates \
      curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --upgrade pip wheel setuptools \
 && pip install --no-cache-dir \
      "numpy<3" "noise==1.2.2" protobuf pypng \
      fastapi "uvicorn[standard]" httpx pydantic \
 && pip install --no-cache-dir -e vendor/worldengine

COPY package.json package-lock.json ./
RUN npm install

COPY . .

ENV PATH="/app/.venv/bin:${PATH}" \
    GEOFORM_API_HOST=0.0.0.0 \
    GEOFORM_API_PORT=8765

EXPOSE 5173 8765

CMD ["npm", "run", "dev"]
