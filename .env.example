# Geoform environment template. Copy to `.env` for local overrides.
# All values shown are the defaults — copy this file as-is and adjust only what you need.

# WorldEngine API server
GEOFORM_API_HOST=127.0.0.1
GEOFORM_API_PORT=8765

# Vite dev server (proxies /api to GEOFORM_API_HOST:PORT)
GEOFORM_WEB_HOST=127.0.0.1
GEOFORM_WEB_PORT=5173

# Optional signed-in library (leave blank until you paste a free Supabase project).
# Worlds stay Download JSON / localStorage until both are set. Never jsonb grids.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Bounds (enforced server-side; see server/api/worlds.py)
GEOFORM_MAX_WIDTH=2048
GEOFORM_MAX_HEIGHT=2048
GEOFORM_MIN_WIDTH=32
GEOFORM_MIN_HEIGHT=32

# Request timeouts (milliseconds)
GEOFORM_GENERATE_TIMEOUT_MS=180000
GEOFORM_RECOMPUTE_TIMEOUT_MS=60000
