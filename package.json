{
  "name": "geoform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite",
    "dev:api": "bash scripts/dev-api.sh",
    "dev:all": "npm run dev:api & npm run dev:web",
    "setup:api": "bash scripts/setup-worldengine.sh",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:client && npm run test:api",
    "test:client": "vitest run",
    "test:client:watch": "vitest",
    "test:api": ".venv/bin/python -m pytest server/tests -q",
    "fixtures:critique": "vite-node scripts/generate-critique-fixtures.mts",
    "aoi:init": "node scripts/aoi-init.mjs",
    "aoi:fetch": "node scripts/aoi-fetch.mjs",
    "smoke": "bash scripts/smoke.sh",
    "start": ".venv/bin/python -m server.api --host 127.0.0.1 --port 8765",
    "start:prod": ".venv/bin/python -m server.api --host 0.0.0.0 --port 8765",
    "install:all": "bash scripts/setup-worldengine.sh && npm install",
    "docker:build": "docker build -t geoform .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "typescript": "~5.6.0",
    "vite": "^8.2.0",
    "vitest": "^3.2.4"
  }
}
