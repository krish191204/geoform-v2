# Dependencies / venv
node_modules/
.venv/
*.egg-info/

# Build output
dist/
build/

# Vendored WorldEngine source (regenerated by `pip install -e vendor/worldengine` and a fresh git pull)
vendor/
vendor/worldengine/.venv/
vendor/worldengine/build/
vendor/worldengine/dist/

# Durable world store (keep .gitkeep so the dir exists)
data/worlds/*.world
data/worlds/*.json
!data/.gitkeep
!data/worlds/.gitkeep

# Editor / OS / Claude
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~
.claude/

# Logs / caches
*.log
npm-debug.log*
yarn-debug.log*
coverage/
.pytest_cache/
__pycache__/
*.pyc
.python-version

# Saved world artifacts
*.world

# Local env files (B-added; safe to ignore — never commit secrets)
.env
.env.local
.env.*.local

# Cursor session artifacts (B-added; recovered via `npx skills add` if needed)
.cursor/

# Empty Cursor vendor-skill placeholders (B-added; gitignored by snapshot, not runtime)
vendor-skills/

# Track A AOI downloads — Cascades rain-shadow calibration (B-added)
# Folders kept via `npm run aoi:init`; contents are gitignored
data/raw/**/*
!data/raw/**/.gitkeep
data/staging/**/*
!data/staging/**/.gitkeep
data/derived/**/*
!data/derived/**/.gitkeep
