{
  "name": "geoform",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "python3 -m server.api --host 127.0.0.1 --port 8765",
    "dev:all": "npm run dev:api & npm run dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:coach": "node scripts/lint-no-dead-coach.mjs",
    "test": "npm run lint:coach && npm run test:client && npm run test:api",
    "test:client": "vitest run",
    "test:client:watch": "vitest",
    "test:api": "python3 -m pytest server/tests -q",
    "start": "python3 -m server.api --host 127.0.0.1 --port 8765",
    "start:prod": "python3 -m server.api --host 0.0.0.0 --port 8765"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.185.4",
    "happy-dom": "^15.0.0",
    "typescript": "~5.6.0",
    "vite": "^8.2.0",
    "vitest": "^3.2.4"
  }
}
